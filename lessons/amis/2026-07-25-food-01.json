      "speaker": "A",
      "amis": "Hay! Mangalay haw tu hemay?",
      "zh": "需要白飯嗎？",
      "highlight": ["hemay"],
      "needsReview": false
    },
    {
      "speaker": "B",
      "amis": "Hay i. Patayni i tu hemay.",
      "zh": "好的，來個白飯吧。",
